{
  "name": "zygiella",
  "version": "0.1.3",
  "description": "A dependency-free file watcher for Node.js, API-compatible with the subset of chokidar that most tools use",
  "keywords": [
    "chokidar",
    "file-watcher",
    "fs.watch",
    "watch",
    "watcher"
  ],
  "homepage": "https://github.com/toiroakr/zygiella#readme",
  "bugs": {
    "url": "https://github.com/toiroakr/zygiella/issues"
  },
  "license": "MIT",
  "author": "toiroakr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toiroakr/zygiella.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/run.mjs",
    "bench:compare": "node bench/compare.mjs",
    "bench:ab": "node bench/ab.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.json src test",
    "lint:fix": "oxlint -c oxlint.json --fix src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "fix:oxlint": "oxlint -c oxlint.json --fix",
    "fix:oxfmt": "oxfmt",
    "knip": "knip",
    "publint": "publint",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.18.0"
}
